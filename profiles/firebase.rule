rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      // Required immediately after Firebase Authentication login.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /programs/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /instructors/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /classes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /registrations/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.participantId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.participantId == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.participantId == request.auth.uid
          && request.resource.data.participantId == request.auth.uid);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.participantId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
